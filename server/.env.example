# Copy of server/.env and fill in. Never commit the real .env

# HS256 signing secret for JWT access tokens. This is a CREDENTIAL.
# - Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# - NEVER commit the real secret.
JWT_SECRET=

# How long an access token stays valid. Keep it short (~15m)
ACCESS_TOKEN_TTL=

# bcrypt cost factor (10-12 is the sane range)
BCRYPT_ROUNDS=

DATABASE_URL=
PORT=
CORS_ORIGIN=